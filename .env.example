# Kopyala: cp .env.example .env  -> sonra anahtarını gir. .env ASLA commit edilmez.
GEMINI_API_KEY=YOUR_API_KEY_HERE
GEMINI_MODEL=YOUR_FREE_TIER_SUPPORTED_MODEL
GEMINI_ENABLED=true
GEMINI_MAX_REQUESTS_PER_TASK=10
GEMINI_DAILY_REQUEST_BUDGET=100
GEMINI_TIMEOUT_S=60
DATABASE_URL=sqlite:///./data/factoryflow.db
# Tesis verisinin harici Gemini API'ye gönderilmesine izin (varsayılan false: veri yerelde kalır, çevrimdışı mod)
EXTERNAL_DATA_CONSENT=false
